# Скопируйте в .env и заполните.

# Случайная строка для подписи сессий панели:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Ключ шифрования токенов TikTok в базе (не теряйте — без него токены не расшифровать):
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=

# Первый администратор панели (создаётся при первом запуске, если пользователей ещё нет).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Адрес, по которому панель открывается в браузере. TikTok требует HTTPS для redirect URI.
# Redirect URI для настроек приложения в TikTok: <PUBLIC_BASE_URL>/api/oauth/tiktok/callback
PUBLIC_BASE_URL=http://localhost:8000
# true, если панель работает по HTTPS.
SESSION_HTTPS_ONLY=false

# Ключи приложения из https://developers.tiktok.com (Login Kit + Content Posting API, Direct Post).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Сколько видео загружается в TikTok одновременно.
UPLOAD_CONCURRENCY=3

# Необязательно: контакт для push-сервисов (mailto:you@example.com или https://ваш-адрес).
# По умолчанию используется PUBLIC_BASE_URL, если он начинается с https://.
VAPID_SUBJECT=
