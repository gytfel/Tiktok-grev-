# Скопируйте в .env и заполните.

# Случайная строка для подписи сессий панели:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Ключ шифрования токенов TikTok в базе (не теряйте — без него токены не расшифровать):
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=

# Первый администратор панели (создаётся при первом запуске, если пользователей ещё нет).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Адрес, по которому панель открывается в браузере. TikTok требует HTTPS для redirect URI.
# Redirect URI для настроек приложения в TikTok: <PUBLIC_BASE_URL>/api/oauth/tiktok/callback
PUBLIC_BASE_URL=http://localhost:8000
# true, если панель работает по HTTPS.
SESSION_HTTPS_ONLY=false

# Ключи приложения из https://developers.tiktok.com (Login Kit + Content Posting API, Direct Post).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Сколько видео загружается в TikTok одновременно.
UPLOAD_CONCURRENCY=3

# Необязательно: контакт для push-сервисов (mailto:you@example.com или https://ваш-адрес).
# По умолчанию используется PUBLIC_BASE_URL, если он начинается с https://.
VAPID_SUBJECT=

# Требовать двухфакторный вход (рекомендуется): без него пользователь сможет только настроить 2FA.
REQUIRE_2FA=true

# Кому доступен порт 8000: 127.0.0.1 — только этому компьютеру (снаружи через HTTPS), 0.0.0.0 — всей сети.
APP_BIND=127.0.0.1

# HTTPS через Caddy (docker-compose.https.yml): домен, который указывает на этот сервер.
DOMAIN=

# Резервные копии в ./backups: как часто (часов) и сколько копий базы хранить.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Аналитика (Display API TikTok): просмотры, лайки, комментарии, репосты своих публичных видео и подписчики.
# Нужен продукт Display API с разрешениями user.info.stats и video.list; после включения переподключите аккаунты.
TIKTOK_ANALYTICS=false
# Как часто собирать статистику, часов.
ANALYTICS_INTERVAL_HOURS=6

# AI-помощник: любой сервис с OpenAI-совместимым API. Бесплатные варианты:
#   локально (docker-compose.ai.yml):  AI_BASE_URL=http://ollama:11434/v1   AI_MODEL=qwen2.5:3b   ключ не нужен
#   OpenRouter, бесплатные модели:     AI_BASE_URL=https://openrouter.ai/api/v1   AI_MODEL=<модель с пометкой :free>
#   Google Gemini, бесплатный тариф:   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=<модель Gemini>
#   Groq, бесплатный тариф:            AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=<модель из списка Groq>
# Оставьте пустым, чтобы работать без AI (шаблоны работают всегда).
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
