{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Publication Queue",
  "mainBinaryName": "publication-queue",
  "version": "0.1.0",
  "identifier": "local.publicationqueue.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Очередь публикаций",
    "longDescription": "Окно панели «Очередь публикаций»: публикация видео в TikTok через официальный API.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
