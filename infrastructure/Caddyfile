# HTTPS для панели: Caddy сам получает и продлевает сертификат Let's Encrypt для DOMAIN.
# Нужен домен, который указывает на IP сервера, и открытые порты 80 и 443.
{$DOMAIN} {
	encode zstd gzip

	# Видео до 4 ГБ загружаются через панель целиком.
	request_body {
		max_size 4GB
	}

	reverse_proxy app:8000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
